# PostgreSQL bağlantısı. Gerçek parolayı buraya yazmayın; bu dosya örnektir.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# Yalnızca docker-compose için. Üretimde güçlü ve benzersiz değerler kullanın.
POSTGRES_USER="soyyigit"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="soyyigit"

# En az 32 karakter. Örnek üretim: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Sitenin genel adresi. Canonical, sitemap ve parola sıfırlama bağlantısı bunu kullanır.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# local veya s3. s3 seçilirse aşağıdaki alanların hepsi dolu olmalıdır.
STORAGE_DRIVER="local"
# S3_ENDPOINT="https://s3.example.com"
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://cdn.example.com"

# Tanımlı değilse parola sıfırlama e-postası gönderilmez. Komut satırı akışı kullanılır.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""

# true ise X-Forwarded-For ilk adresi giriş limiti için kullanılır. Yalnızca güvendiğiniz ters vekil arkasında açın.
TRUST_PROXY="false"
